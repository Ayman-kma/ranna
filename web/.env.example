# API base URL the browser/phone uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Base URL encoded into customer QR codes / links (must be phone-reachable).
# For phone testing on Wi-Fi use your Mac's LAN IP, e.g. http://192.168.1.20:3000
# For HTTPS push testing use a tunnel URL, e.g. https://xxxx.trycloudflare.com
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
